---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Projects">
  <h1>Projects</h1>
  {projects.length === 0 ? <p class="empty">Nothing here yet.</p> :
    <ul class="cards">
      {projects.map((p) => (
        <li class="card">
          <h3><a href={`/projects/${p.id}/`}>{p.data.title}</a></h3>
          <p>{p.data.summary}</p>
          <ul class="tags">{p.data.tags.map((t) => <li>{t}</li>)}</ul>
        </li>
      ))}
    </ul>}
</Base>
