---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Projects">
  <header class="page-head">
    <h1>Projects</h1>
    <p class="deck">What I built, when, and where the write-up is.</p>
  </header>
  {projects.length === 0 ? <p class="empty">Projects will be listed here.</p> :
    <ul class="entries">
      {projects.map((p) => (
        <li class="entry">
          <div class="when">{p.data.period ?? ''}</div>
          <div>
            <h3><a href={`/projects/${p.id}/`}>{p.data.title}</a></h3>
            <p>{p.data.summary}</p>
            {p.data.tags.length > 0 && <p class="tags">{p.data.tags.join(', ')}</p>}
          </div>
        </li>
      ))}
    </ul>}
</Base>
