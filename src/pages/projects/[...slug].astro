---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  return (await getCollection('projects')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const posts = (await getCollection('blog'))
  .filter((p) => p.data.project === entry.id)
  .sort((a, b) => a.data.order - b.data.order);
---
<Base title={entry.data.title} description={entry.data.summary}>
  <header class="post-head">
    <p class="kicker"><a href="/projects/">Projects</a></p>
    <h1>{entry.data.title}</h1>
    <p class="lede">{entry.data.summary}</p>
    <ul class="tags">{entry.data.tags.map((t) => <li>{t}</li>)}</ul>
    {(entry.data.repo || entry.data.link) && (
      <div class="links">
        {entry.data.repo && <a class="btn" href={entry.data.repo}>Code on GitHub</a>}
        {entry.data.link && <a class="btn secondary" href={entry.data.link}>Project link</a>}
      </div>
    )}
  </header>
  <div class="prose"><Content /></div>
  {posts.length > 0 && (
    <>
      <h2>Writing in this project</h2>
      <ol class="series">
        {posts.map((p) => (
          <li>
            <span class="num">{String(p.data.order).padStart(2, '0')}</span>
            <div><a href={`/blog/${p.id}/`}>{p.data.title}</a><span class="meta">{p.data.description}</span></div>
          </li>
        ))}
      </ol>
    </>
  )}
</Base>
