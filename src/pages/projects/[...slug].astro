---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  return (await getCollection('projects')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const posts = (await getCollection('blog'))
  .filter((p) => p.data.project === entry.id)
  .sort((a, b) => a.data.order - b.data.order);
---
<Base title={entry.data.title} description={entry.data.summary}>
  <header class="post-head">
    <p class="crumb"><a href="/projects/">Projects</a>{entry.data.period && `, ${entry.data.period}`}</p>
    <h1>{entry.data.title}</h1>
    <p class="deck">{entry.data.summary}</p>
    {entry.data.tags.length > 0 && <p class="meta">{entry.data.tags.join(', ')}</p>}
    {(entry.data.repo || entry.data.link) && (
      <p class="links">
        {entry.data.repo && <a href={entry.data.repo}>Code on GitHub</a>}
        {entry.data.link && <a href={entry.data.link}>Project link</a>}
      </p>
    )}
  </header>
  <div class="prose"><Content /></div>
  {posts.length > 0 && (
    <section class="series-group">
      <h2>The write-up, in {posts.length} parts</h2>
      <ol class="series">
        {posts.map((p) => (
          <li>
            <span class="num" aria-hidden="true">{p.data.order}</span>
            <div><a href={`/blog/${p.id}/`}>{p.data.title}</a><span class="meta">{p.data.description}</span></div>
          </li>
        ))}
      </ol>
    </section>
  )}
</Base>
