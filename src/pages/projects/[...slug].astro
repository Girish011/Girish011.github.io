---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  return (await getCollection('projects')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const posts = (await getCollection('blog'))
  .filter((p) => p.data.project === entry.id)
  .sort((a, b) => a.data.order - b.data.order);
---
<Base title={entry.data.title} description={entry.data.summary}>
  <h1>{entry.data.title}</h1>
  <p class="lede">{entry.data.summary}</p>
  <ul class="tags">{entry.data.tags.map((t) => <li>{t}</li>)}</ul>
  <p>
    {entry.data.repo && <a href={entry.data.repo}>Code on GitHub</a>}
    {entry.data.repo && entry.data.link && ' · '}
    {entry.data.link && <a href={entry.data.link}>Project link</a>}
  </p>
  <div class="prose"><Content /></div>
  {posts.length > 0 && (
    <>
      <h2>Writing in this project</h2>
      <ol class="list">
        {posts.map((p) => (
          <li><a href={`/blog/${p.id}/`}>{p.data.title}</a><span class="meta">{p.data.description}</span></li>
        ))}
      </ol>
    </>
  )}
</Base>
