---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
const jobs = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(jobs.map(async (j) => ({ j, Content: (await render(j)).Content })));
---
<Base title="Experience">
  <header class="page-head">
    <h1>Experience</h1>
    <p class="deck">Where I have worked and what I did there.</p>
  </header>
  {rendered.length === 0 ? <p class="empty">Work experience will be listed here.</p> :
    <ul class="entries">
      {rendered.map(({ j, Content }) => (
        <li class="entry">
          <div class="when">{j.data.start} to {j.data.end}</div>
          <div>
            <h3>{j.data.role}, {j.data.company}</h3>
            <div class="prose"><Content /></div>
          </div>
        </li>
      ))}
    </ul>}
</Base>
