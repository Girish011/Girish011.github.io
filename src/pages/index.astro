---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured);
---
<Base title="Girish" description="Portfolio of Girish: projects, writing, papers, certifications and experience.">
  <h1>Hi, I'm Girish.</h1>
  <p class="lede">I build machine-learning systems and write up what works and what does not. This site collects my projects, blog posts, papers, certifications and work experience.</p>

  <h2>Featured projects</h2>
  {featured.length === 0
    ? <p class="empty">Projects are coming soon.</p>
    : <ul class="cards">
        {featured.map((p) => (
          <li class="card">
            <h3><a href={`/projects/${p.id}/`}>{p.data.title}</a></h3>
            <p>{p.data.summary}</p>
            <ul class="tags">{p.data.tags.map((t) => <li>{t}</li>)}</ul>
          </li>
        ))}
      </ul>}
  <p><a href="/projects/">All projects</a> · <a href="/blog/">All writing</a></p>
</Base>
