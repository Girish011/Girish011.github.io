---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = await getCollection('blog');
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const groups = projects
  .map((proj) => ({ proj, posts: posts.filter((p) => p.data.project === proj.id).sort((a, b) => a.data.order - b.data.order) }))
  .filter((g) => g.posts.length > 0);
---
<Base title="Blog">
  <header class="page-head">
    <h1>Blog</h1>
    <p class="lede">Writing, grouped by project and read in order.</p>
  </header>
  {groups.length === 0 ? <p class="empty">No posts yet.</p> : groups.map((g) => (
    <section class="project-group">
      <h2><a href={`/projects/${g.proj.id}/`}>{g.proj.data.title}</a></h2>
      <ol class="series">
        {g.posts.map((p) => (
          <li>
            <span class="num">{String(p.data.order).padStart(2, '0')}</span>
            <div><a href={`/blog/${p.id}/`}>{p.data.title}</a><span class="meta">{p.data.description}</span></div>
          </li>
        ))}
      </ol>
    </section>
  ))}
</Base>
