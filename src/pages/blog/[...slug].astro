---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort((a, b) => a.data.order - b.data.order);
  return posts.map((entry) => {
    const sibs = posts.filter((p) => p.data.project === entry.data.project);
    const i = sibs.findIndex((p) => p.id === entry.id);
    return { params: { slug: entry.id }, props: { entry, prev: sibs[i - 1], next: sibs[i + 1] } };
  });
}
const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const projects = await getCollection('projects');
const project = projects.find((p) => p.id === entry.data.project);
---
<Base title={entry.data.title} description={entry.data.description}>
  {project && <p class="meta"><a href={`/projects/${project.id}/`}>{project.data.title}</a> · Part {entry.data.order}</p>}
  <article>
    <h1>{entry.data.title}</h1>
    <div class="prose"><Content /></div>
  </article>
  <nav class="post-nav" aria-label="Series">
    <span>{prev && <a href={`/blog/${prev.id}/`}>&larr; {prev.data.title}</a>}</span>
    <span>{next && <a href={`/blog/${next.id}/`}>{next.data.title} &rarr;</a>}</span>
  </nav>
</Base>
