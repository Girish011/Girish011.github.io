---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort((a, b) => a.data.order - b.data.order);
  return posts.map((entry) => {
    const sibs = posts.filter((p) => p.data.project === entry.data.project);
    const i = sibs.findIndex((p) => p.id === entry.id);
    return { params: { slug: entry.id }, props: { entry, prev: sibs[i - 1], next: sibs[i + 1], total: sibs.length } };
  });
}
const { entry, prev, next, total } = Astro.props;
const { Content } = await render(entry);
const projects = await getCollection('projects');
const project = projects.find((p) => p.id === entry.data.project);
---
<Base title={entry.data.title} description={entry.data.description}>
  <article>
    <header class="post-head">
      {project && <p class="crumb">Part {entry.data.order} of {total} in <a href={`/projects/${project.id}/`}>{project.data.title}</a></p>}
      <h1>{entry.data.title}</h1>
      <p class="deck">{entry.data.description}</p>
    </header>
    <div class="prose"><Content /></div>
  </article>
  {(prev || next) && (
    <nav class="post-nav" aria-label="Series">
      {prev && <a class="prev" href={`/blog/${prev.id}/`}><small>Previous, part {prev.data.order}</small><span>{prev.data.title}</span></a>}
      {next && <a class="next" href={`/blog/${next.id}/`}><small>Next, part {next.data.order}</small><span>{next.data.title}</span></a>}
    </nav>
  )}
</Base>
