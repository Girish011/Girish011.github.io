---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
const papers = (await getCollection('papers')).sort((a, b) => b.data.year - a.data.year);
---
<Base title="Papers">
  <header class="page-head">
    <h1>Papers</h1>
    <p class="lede">Research papers and preprints.</p>
  </header>
  {papers.length === 0 ? <p class="empty">Papers will be listed here.</p> :
    <ul class="list">
      {papers.map((p) => (
        <li>
          {p.data.url ? <a href={p.data.url}>{p.data.title}</a> : <strong>{p.data.title}</strong>}
          <span class="meta">{p.data.authors} · {p.data.venue}, {p.data.year}</span>
        </li>
      ))}
    </ul>}
</Base>
