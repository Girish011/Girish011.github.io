---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
const certs = await getCollection('certifications');
---
<Base title="Certifications">
  <header class="page-head">
    <h1>Certifications</h1>
    <p class="deck">Courses and credentials.</p>
  </header>
  {certs.length === 0 ? <p class="empty">Certifications will be listed here.</p> :
    <ul class="entries">
      {certs.map((c) => (
        <li class="entry">
          <div class="when">{c.data.date}</div>
          <div>
            <h3>{c.data.url ? <a href={c.data.url}>{c.data.title}</a> : c.data.title}</h3>
            <p class="meta">{c.data.issuer}</p>
          </div>
        </li>
      ))}
    </ul>}
</Base>
