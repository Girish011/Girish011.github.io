---
import { getCollection } from 'astro:content';
import '../styles/global.css';

interface Props { title: string; description?: string }
const { title, description = 'Portfolio: projects, writing, papers, certifications and experience.' } = Astro.props;

const count = async (c: 'projects' | 'blog' | 'papers' | 'certifications' | 'experience') => (await getCollection(c)).length;
const nav: [string, string, number | null][] = [
  ['Projects', '/projects/', await count('projects')],
  ['Writing', '/blog/', await count('blog')],
  ['Papers', '/papers/', await count('papers')],
  ['Certifications', '/certifications/', await count('certifications')],
  ['Experience', '/experience/', await count('experience')],
  ['About', '/about/', null],
];
const path = Astro.url.pathname;
const full = title === 'Girish' ? 'Girish, machine learning engineer' : `${title} | Girish`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eef1ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#18211e" media="(prefers-color-scheme: dark)" />
    <title>{full}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Literata:ital,opsz,wght@0,7..72,400..700;1,7..72,400&display=swap" rel="stylesheet" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <div class="shell">
      <header class="rail graph">
        <a class="name" href="/">Girish<small>Machine learning, measured honestly.</small></a>
        <nav aria-label="Main">
          <ul class="index">
            {nav.map(([label, href, n]) => (
              <li>
                <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>
                  <span>{label}</span>
                  {n !== null && <span class="count" aria-label={`${n} items`}>{n}</span>}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="rail-foot">
          <a class="gh" href="https://github.com/Girish011">GitHub</a>
          <button class="theme-toggle" type="button">Dark mode</button>
        </div>
      </header>
      <main id="content"><slot /></main>
    </div>
    <script is:inline>
      (function () {
        const root = document.documentElement;
        const btn = document.querySelector('.theme-toggle');
        const isDark = () => root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        const label = () => { btn.textContent = isDark() ? 'Light mode' : 'Dark mode'; };
        root.dataset.theme = isDark() ? 'dark' : 'light';
        label();
        btn.addEventListener('click', () => {
          const next = isDark() ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch (e) {}
          label();
        });
      })();
    </script>
  </body>
</html>
