---
import '../styles/global.css';

interface Props { title: string; description?: string }
const { title, description = 'Portfolio: projects, writing, papers, certifications and experience.' } = Astro.props;

const nav = [
  ['Projects', '/projects/'],
  ['Blog', '/blog/'],
  ['Papers', '/papers/'],
  ['Certifications', '/certifications/'],
  ['Experience', '/experience/'],
  ['About', '/about/'],
];
const path = Astro.url.pathname;
const full = title === 'Girish' ? title : `${title} | Girish`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{full}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">Girish</a>
        <nav aria-label="Main">
          {nav.map(([label, href]) => (
            <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main class="wrap"><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <a href="https://github.com/Girish011">GitHub</a>
      </div>
    </footer>
  </body>
</html>
